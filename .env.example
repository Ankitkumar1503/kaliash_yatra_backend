PORT=5000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=chaiDB
DB_USER=your_postgres_user
DB_PASSWORD=replace-me
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=mission-nepal-api
JWT_AUDIENCE=mission-nepal-clients

PUBLIC_WEB_ORIGIN=http://localhost:3000
CMS_WEB_ORIGIN=http://localhost:5175
CORS_ALLOWED_ORIGINS=
AUTH_RATE_LIMIT=10
PUBLIC_WRITE_RATE_LIMIT=20

# Storage Configuration (local | s3)
STORAGE_DRIVER=local

# Cloudflare R2 / AWS S3 Settings (Required if STORAGE_DRIVER=s3)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=kailash-yatra-media
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_PUBLIC_URL_PREFIX=https://media.kailashyatraguide.com

# Local Storage Settings (Used when STORAGE_DRIVER=local)
LOCAL_UPLOAD_DIR=./public
LOCAL_PUBLIC_URL_PREFIX=
